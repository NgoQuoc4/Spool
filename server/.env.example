# Server Port & Environment
PORT=4000
NODE_ENV=development

# Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/twitter_dev?schema=public"

# Base URLs
BASE_URL_DEV=http://localhost:4000
BASE_URL_PROD=https://api.yourdomain.com

# Client Frontend URL (CORS & Email redirect links)
CLIENT_URL=http://localhost:3000

# Security & Secrets
PASSWORD_SECRET=your_password_secret_key
JWT_SECRET_ACCESS_TOKEN=your_jwt_access_token_secret
JWT_SECRET_REFRESH_TOKEN=your_jwt_refresh_token_secret
JWT_SECRET_EMAIL_VERIFY_TOKEN=your_jwt_email_verify_secret
JWT_SECRET_FORGOT_PASSWORD_TOKEN=your_jwt_forgot_password_secret

# Token Expiration
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=100d
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=1d
FORGOT_PASSWORD_TOKEN_EXPIRES_IN=15m

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URIS=http://localhost:4000/user/oauth/google

# Email Configuration (Nodemailer - Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Gemini AI (NewsBot & AI features)
GEMINI_API_KEY=your_gemini_api_key